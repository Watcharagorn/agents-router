{
  "description": "Agents Router: wake the main session when a subagent finishes or asks something (watched again after each subagent_message), and name uncollected results after resume or compaction.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_agents-router_agents-router__subagent_start|mcp__agents-router__subagent_start",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      },
      {
        "matcher": "mcp__plugin_agents-router_agents-router__subagent_message|mcp__agents-router__subagent_message",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook pending",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
