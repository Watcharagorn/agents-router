{
  "description": "Agents Router: wake the main session when a subagent finishes or asks something (watched again after each subagent_message), name uncollected results after resume or compaction, and prefer installed role agents for subagent work.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_agents-router_agents-router__subagent_start|mcp__agents-router__subagent_start",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      },
      {
        "matcher": "mcp__plugin_agents-router_agents-router__subagent_message|mcp__agents-router__subagent_message",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook roles-first",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook pending",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "agt hook roles-context",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
