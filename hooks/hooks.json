{
  "description": "CLI Subagents: wake the main session when a subagent finishes or asks something, and name uncollected results after resume or compaction.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_cli-subagents_cli-subagents__subagent_start|mcp__cli-subagents__subagent_start",
        "hooks": [
          {
            "type": "command",
            "command": "csa hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "csa hook pending",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
